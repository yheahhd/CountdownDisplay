<Window x:Class="CountdownDisplay.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统时钟" SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize">
    <Border Padding="12,6" CornerRadius="14" Background="#14111A2D">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <TextBlock x:Name="ClockText" FontFamily="Microsoft YaHei UI" FontSize="17" FontWeight="SemiBold"
                   Foreground="#F8FAFC" TextOptions.TextFormattingMode="Display"/>
    </Border>
</Window>

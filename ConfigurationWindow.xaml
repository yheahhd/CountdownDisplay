<Window x:Class="CountdownDisplay.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="倒计时显示器设置" Width="570" Height="760" MinWidth="520" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,22,5"/><Setter Property="FontSize" Value="14"/></Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="倒计时显示器" FontSize="25" FontWeight="SemiBold" Foreground="#0F172A"/>
            <TextBlock Text="设置一次，桌面就会以一行克制的文字持续显示。目标时间按中国标准时间（UTC+8）理解。"
                       Margin="0,8,0,22" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="显示文字" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="TitleBox" Margin="0,7,0,20" Padding="10,7" FontSize="14" MaxLength="40"/>

                <TextBlock Text="截至日期与时间" FontWeight="SemiBold" Foreground="#334155"/>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,6">
                    <DatePicker x:Name="TargetDatePicker" Width="210" Height="34"/>
                    <ComboBox x:Name="HourBox" Width="75" Height="34" Margin="10,0,0,0"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="7,0" FontSize="18"/>
                    <ComboBox x:Name="MinuteBox" Width="75" Height="34"/>
                </StackPanel>
                <TextBlock Text="例如：2027 年 6 月 14 日 08:00。" Foreground="#64748B" FontSize="12" Margin="0,0,0,20"/>

                <TextBlock Text="显示单位（可多选）" FontWeight="SemiBold" Foreground="#334155"/>
                <WrapPanel Margin="0,5,0,18">
                    <CheckBox x:Name="YearCheck" Content="年"/>
                    <CheckBox x:Name="MonthCheck" Content="月"/>
                    <CheckBox x:Name="DayCheck" Content="天"/>
                    <CheckBox x:Name="HourCheck" Content="时"/>
                    <CheckBox x:Name="SecondCheck" Content="秒"/>
                </WrapPanel>

                <TextBlock Text="计算方式" FontWeight="SemiBold" Foreground="#334155"/>
                <StackPanel Margin="0,6,0,18">
                    <RadioButton x:Name="HierarchicalRadio" GroupName="Mode" Content="从大到小拆分（推荐）" IsChecked="True" FontSize="14"/>
                    <TextBlock Text="年 = 365 天、月 = 30 天。比如 395 天选择年和月，显示为 1年 1月。"
                               Foreground="#64748B" FontSize="12" Margin="24,4,0,8" TextWrapping="Wrap"/>
                    <RadioButton x:Name="IndependentRadio" GroupName="Mode" Content="每个单位独立折算" FontSize="14"/>
                    <TextBlock Text="各单位均以完整倒计时独立换算，结果保留最多两位小数。"
                               Foreground="#64748B" FontSize="12" Margin="24,4,0,0"/>
                </StackPanel>

                <CheckBox x:Name="ClickThroughCheck" Content="鼠标穿透桌面文字（开启后请从系统托盘打开设置）" Margin="0,2,0,15"/>
                <CheckBox x:Name="StayOnTopCheck" Content="置顶显示（取消后显示在最下层）" Margin="0,0,0,15"/>

                <TextBlock Text="倒计时位置与大小" FontWeight="SemiBold" Foreground="#334155"/>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,18">
                    <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="CountdownXBox" Width="72" Padding="7,5"/>
                    <TextBlock Text="Y" VerticalAlignment="Center" Margin="13,0,6,0"/>
                    <TextBox x:Name="CountdownYBox" Width="72" Padding="7,5"/>
                    <TextBlock Text="字号" VerticalAlignment="Center" Margin="13,0,6,0"/>
                    <TextBox x:Name="CountdownSizeBox" Width="72" Padding="7,5"/>
                </StackPanel>

                <CheckBox x:Name="ShowClockCheck" Content="显示系统时钟（使用本机系统时间）" Margin="0,0,0,8"/>
                <CheckBox x:Name="ShowClockSecondsCheck" Content="时钟显示秒" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <TextBlock Text="时钟 X" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="ClockXBox" Width="72" Padding="7,5"/>
                    <TextBlock Text="Y" VerticalAlignment="Center" Margin="13,0,6,0"/>
                    <TextBox x:Name="ClockYBox" Width="72" Padding="7,5"/>
                    <TextBlock Text="字号" VerticalAlignment="Center" Margin="13,0,6,0"/>
                    <TextBox x:Name="ClockSizeBox" Width="72" Padding="7,5"/>
                </StackPanel>

                <CheckBox x:Name="StartWithWindowsCheck" Content="开机时自动启动倒计时显示器" Margin="0,0,0,15"/>

                <Border Background="#EEF6FF" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock x:Name="TimeStatusText" Foreground="#1E3A5F" TextWrapping="Wrap"/>
                        <Button Content="立即校准" Click="OnSynchronizeTime" DockPanel.Dock="Right" Padding="10,4" Margin="12,0,0,0"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="OnCancel"/>
            <Button Content="保存并显示" Click="OnSave" Background="#2563EB" Foreground="White" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
